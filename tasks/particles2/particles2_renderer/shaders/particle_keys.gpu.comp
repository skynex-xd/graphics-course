#version 460
layout(local_size_x = 64) in;

layout(push_constant) uniform KeysPC {
    mat4 projView;
} pc;

struct ParticleGpu {
    vec4 pos_size;
    vec4 vel_age;
    vec4 col_life;
};

layout(set=0, binding=0, std430) readonly  buffer Particles { ParticleGpu P[]; };
layout(set=0, binding=1, std430) writeonly buffer Keys      { float        keys[]; };
layout(set=0, binding=2, std430) writeonly buffer Indices   { uint         idxs[]; };
layout(set=0, binding=3, std430)          buffer Alive      { uint         aliveCount; };
layout(set=0, binding=4, std430) readonly buffer Mask { uint M[]; };

uint nextPow2(uint v) { v = max(1u, v); v--; v |= v>>1; v|=v>>2; v|=v>>4; v|=v>>8; v|=v>>16; v++; return v; }

void main(){
    uint i = gl_GlobalInvocationID.x;
    uint alive = aliveCount;
    uint N2 = nextPow2(alive);

    if (i >= N2) return;

    if (i < alive) {
        bool vis = (M[i] != 0u);
        if (vis) {
            vec3 pos = P[i].pos_size.xyz;
            vec4 clip = pc.projView * vec4(pos, 1.0);
            float ndcZ = clip.z / max(1e-8, clip.w);
            keys[i] = -ndcZ;
            idxs[i] = i;
        } else {
            keys[i] = 3.4028235e38;
            idxs[i] = 0u;
        }
    } else {
        keys[i] = 3.4028235e38;
        idxs[i] = 0u;
    }
}
