#version 460
layout(local_size_x = 64) in;

layout(push_constant) uniform SimPC {
    float dt;
    uint  inCount;
    uint  capacity;
    uint  _pad;
} pc;

struct ParticleGpu {
    vec4 pos_size;
    vec4 vel_age;
    vec4 col_life;
};

layout(set=0, binding=0, std430) readonly  buffer InBuf  { ParticleGpu inP[]; };
layout(set=0, binding=1, std430) writeonly buffer OutBuf { ParticleGpu outP[]; };
layout(set=0, binding=2, std430) buffer Alive { uint aliveCount; };

void main(){
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.inCount) return;

    ParticleGpu p = inP[i];
    p.vel_age.w += pc.dt;
    if (p.vel_age.w >= p.col_life.w) return;
    vec3 g = vec3(0.0, -0.5, 0.0);
    p.vel_age.xyz += g * pc.dt;
    p.pos_size.xyz += p.vel_age.xyz * pc.dt;
    uint dst = atomicAdd(aliveCount, 1u);
    if (dst >= pc.capacity) {
        atomicAdd(aliveCount, 0xffffffffu);
        return;
    }
    outP[dst] = p;
}
