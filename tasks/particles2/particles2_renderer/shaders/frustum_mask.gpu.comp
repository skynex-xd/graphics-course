#version 460
layout(local_size_x = 64) in;

struct ParticleGpu {
    vec4 pos_size;
    vec4 vel_age;
    vec4 col_life;
};

layout(push_constant) uniform PC {
    mat4 projView;
    uint count;
} pc;

layout(set=0, binding=0, std430) readonly  buffer Particles { ParticleGpu P[]; };
layout(set=0, binding=1, std430)          buffer Mask      { uint        M[]; };
layout(set=0, binding=2, std430)          buffer Counter   { uint        visibleCount; };

bool insideClip(vec4 clip)
{
    float w = clip.w;
    if (clip.x < -w || clip.x > w) return false;
    if (clip.y < -w || clip.y > w) return false;
    if (clip.z <  0.0 || clip.z > w) return false;
    return true;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;

    vec3  wpos = P[i].pos_size.xyz;
    vec4  clip = pc.projView * vec4(wpos, 1.0);
    bool  vis  = insideClip(clip);

    M[i] = vis ? 1u : 0u;
    if (vis) atomicAdd(visibleCount, 1u);
}